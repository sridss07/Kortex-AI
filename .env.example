# CREOZEN LTD Generative AI Workspace - Environment Configuration Template
# Copy this file to .env or .env.local for local development

# Base URL for the CREOZEN Backend API (e.g. http://localhost:8000/api/v1 or https://api.creozen.ai/v1)
# Leave empty or set to 'mock' to use realistic simulated mock service data
VITE_API_BASE_URL=

# App environment mode
VITE_APP_ENV=development

# Optional: Enable verbose API debug logging (true/false)
VITE_ENABLE_DEBUG_LOGS=true
